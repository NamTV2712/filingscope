# SEC requests require a descriptive application name and a real contact email.
SEC_USER_AGENT=FilingScope research contact@example.com

# Local Qdrant is the safe single-process default. Cloud settings are optional.
QDRANT_MODE=local
QDRANT_LOCAL_PATH=data/processed/qdrant
QDRANT_INDEX_MANIFEST_PATH=data/processed/qdrant_index_manifest.json
QDRANT_CLOUD_URL=
QDRANT_CLOUD_API_KEY=

# Keep the embedding and reranker model revisions pinned to the source baseline.
EMBEDDING_MODEL_ID=nomic-ai/nomic-embed-text-v1.5
EMBEDDING_MODEL_REVISION=e9b6763023c676ca8431644204f50c2b100d9aab
RERANKER_MODEL_ID=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_MODEL_REVISION=233902d25c440f23af6f7d6e94d2946bac0bee0a
EMBEDDING_GENERATIONS_DIR=data/embedding_generations
# Set only to a completed, validated generation before indexing.
# EMBEDDING_GENERATION_PATH=data/embedding_generations/<generation-id>
